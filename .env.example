# pascabowo-gatekeeper — example environment. Copy to .env and fill in.
# NEVER commit a real .env — it holds the platform HMAC secret.

# Required. Issued once when you register the agent on the Agent Games
# dashboard ("Rotate Secret"). The platform signs every task with this
# secret; without it the server answers 500 server_misconfigured.
AGENT_GAMES_HMAC_SECRET=

# Optional. Kurier (zkVerify) mainnet API key. When set, each generated
# proof is submitted to zkVerify mainnet and the on-chain tx hash is
# returned as proof_tx. When unset, proofs are generated locally only
# and proof_tx falls back to the task's input proof_tx.
KURIER_API_KEY=

# Optional overrides (defaults shown).
# KURIER_API_URL=https://api.kurier.xyz/api/v1
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# PORT=8787
# TASK_SOFT_DEADLINE_MS=50000
